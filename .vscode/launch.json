{
    "version": "0.2.0",
    "configurations": [
        // --- 1. ECHTES DEBUGGING ---
        {
            "name": "🐛 [Debug] Xdebug (Herd Backend)",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "${workspaceFolder}/backend": "${workspaceFolder}/backend"
            },
            "ignore": [
                "**/vendor/**/*.php"
            ],
            "presentation": {
                "group": "1_debug",
                "order": 1
            }
        },
        // --- 2. START & RUN ---
        {
            "name": "🐳 [Run] Start Docker (Local)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "-e",
                "console.log('🐳 Lokale Docker-Container (MariaDB, Meilisearch, Mailpit) werden gestartet!')"
            ],
            "preLaunchTask": "Start Docker",
            "console": "internalConsole",
            "presentation": {
                "group": "2_run",
                "order": 1
            }
        },
        {
            "name": "⚡ [Run] Start Frontend (Vite)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "-e",
                "console.log('⚡ Frontend Dev-Server startet!\\nURL: http://localhost:4321')"
            ],
            "preLaunchTask": "Start Frontend",
            "console": "internalConsole",
            "presentation": {
                "group": "2_run",
                "order": 2
            }
        },
        // --- 3. SETUP & INIT ---
        {
            "name": "📦 [Setup] Backend: Composer Install",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "-e",
                "console.log('✅ Composer Dependencies installiert!')"
            ],
            "preLaunchTask": "Composer Install",
            "console": "internalConsole",
            "presentation": {
                "group": "3_setup",
                "order": 0
            }
        },
        {
            "name": "⚙️ [Setup] Backend: Config & Cache Reset",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "-e",
                "console.log('✅ Backend Cache & Config zurückgesetzt!')"
            ],
            "preLaunchTask": "Init Backend",
            "console": "internalConsole",
            "presentation": {
                "group": "3_setup",
                "order": 1
            }
        },
        {
            "name": "🔑 [Setup] Backend: JWT Secret generieren",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "-e",
                "console.log('✅ JWT Secret generiert!')"
            ],
            "preLaunchTask": "Generate JWT",
            "console": "internalConsole",
            "presentation": {
                "group": "3_setup",
                "order": 2
            }
        },
        {
            "name": "💾 [Setup] Backend: DB Migration (Update)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "-e",
                "console.log('✅ Datenbank migriert!')"
            ],
            "preLaunchTask": "Migrate DB",
            "console": "internalConsole",
            "presentation": {
                "group": "3_setup",
                "order": 3
            }
        },
        // --- 4. WARTUNG ---
        {
            "name": "🔍 [Wartung] Meilisearch Sync & Import",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "-e",
                "console.log('✅ Meilisearch synchronisiert!')"
            ],
            "preLaunchTask": "Sync Meilisearch",
            "console": "internalConsole",
            "presentation": {
                "group": "4_maintenance",
                "order": 1
            }
        },
        {
            "name": "🛑 [Core] Stop Docker (Graceful)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "-e",
                "console.log('🛑 Docker gestoppt!')"
            ],
            "preLaunchTask": "Stop Docker",
            "console": "internalConsole",
            "presentation": {
                "group": "5_core",
                "order": 1
            }
        },
        // --- 5. GEFAHR ---
        {
            "name": "🧨 [Gefahr] DB Reset & Seed",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "-e",
                "console.log('🧨 DB Reset abgeschlossen!')"
            ],
            "preLaunchTask": "Reset DB",
            "console": "internalConsole",
            "presentation": {
                "group": "6_danger",
                "order": 1
            }
        }
    ]
}