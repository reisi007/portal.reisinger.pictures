{
    "output": {
        "style": "markdown",
        "filePath": "repomix-portal-frontend.md",
        "fileSummary": true,
        "directoryStructure": true
    },
    "include": [
        "*",
        ".run/**/*",
        "deployment/**/*",
        "frontend/**/*",
        "backend/**/*"
    ],
    "ignore": {
        "useGitignore": true,
        "useDefaultPatterns": true,
        "customPatterns": [
            "frontend/node_modules/**",
            "backend/vendor/**",
            "admin.lrplugin/**"
        ]
    }
}