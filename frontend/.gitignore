# Env files are untracked. Only the *.example templates are committed
# (see root .gitignore allowlist). Never negate-ignore real .env files here —
# doing so forces Git to track real secrets.

# Vitest v8 coverage report (pnpm test:coverage)
coverage/

# UI-review screenshot harness (playwright.screenshots.config.ts).
# Already covered globally by the root .gitignore; kept here for explicitness.
test-results/
playwright-report/
