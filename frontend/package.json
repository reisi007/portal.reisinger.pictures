{
    "name": "portal-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@9.15.4",
    "scripts": {
        "dev": "vite",
        "prebuild": "tsc -b && node scripts/check-i18n.mjs",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0",
        "test:e2e": "playwright test",
        "test:e2e:smoke": "playwright test --grep @smoke",
        "test:e2e:grep": "playwright test --grep",
        "test:e2e:failed": "playwright test --last-failed",
        "test:e2e:ui": "playwright test --ui",
        "test": "vitest",
        "test:run": "vitest run",
        "test:watch": "vitest",
        "lingui:extract": "lingui extract",
        "lingui:compile": "lingui compile",
        "check:i18n": "node scripts/check-i18n.mjs"
    },
    "dependencies": {
        "@dnd-kit/react": "^0.5.0",
        "@hookform/resolvers": "^5.4.0",
        "@lingui/babel-plugin-lingui-macro": "^6.6.0",
        "@lingui/core": "^6.6.0",
        "@lingui/react": "^6.6.0",
        "@lingui/vite-plugin": "^6.6.0",
        "@stripe/react-stripe-js": "^6.7.0",
        "@stripe/stripe-js": "^9.9.0",
        "@tiptap/core": "^3.27.1",
        "@tiptap/extension-table": "^3.27.1",
        "@tiptap/extension-table-cell": "^3.27.1",
        "@tiptap/extension-table-header": "^3.27.1",
        "@tiptap/extension-table-row": "^3.27.1",
        "@tiptap/react": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "dompurify": "^3.4.12",
        "photoswipe": "^5.4.4",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-helmet-async": "^3.0.0",
        "react-hook-form": "^7.80.0",
        "react-router-dom": "^7.18.1",
        "recharts": "^3.9.2",
        "swr": "^2.4.2",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@iconify-json/material-symbols": "^1.2.82",
        "@iconify-json/mdi": "^1.2.3",
        "@iconify/tailwind4": "^1.2.3",
        "@lingui/cli": "^6.6.0",
        "@lingui/format-po": "^6.6.0",
        "@playwright/test": "^1.61.1",
        "@rolldown/plugin-babel": "^0.2.3",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^26.1.0",
        "@types/pdf-parse": "^1.1.5",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "daisyui": "^5.6.13",
        "eslint": "^10.6.0",
        "eslint-plugin-lingui": "^0.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "pdf-parse": "^2.4.5",
        "tailwindcss": "^4.3.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.1",
        "vite": "^8.1.3",
        "vitest": "^4.1.9"
    }
